<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- 锁屏主体 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:id="@+id/countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.05"
            android:text="05:00"
            android:textColor="@color/ink"
            android:textSize="48sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.3"
            android:text="稍作休息"
            android:textColor="@color/inkSoft"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/ring"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="220dp"
            android:layout_height="8dp"
            android:layout_marginTop="28dp"
            android:max="100"
            android:progress="100"
            android:progressBackgroundTint="@color/firLight"
            android:progressTint="@color/fir" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:letterSpacing="0.1"
            android:text="请稍作休息 🌿"
            android:textColor="@color/ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="所有应用已上锁。放下手机，看看远处，\n或跟着下面的圆点做几次深呼吸。"
            android:textColor="@color/inkSoft"
            android:textSize="13sp" />

        <View
            android:id="@+id/breathe"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/circle_breathe" />
    </LinearLayout>

    <!-- 「请稍作休息」弹窗 -->
    <FrameLayout
        android:id="@+id/restPopup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ink40"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="30dp"
                android:paddingEnd="30dp"
                android:paddingTop="36dp"
                android:paddingBottom="28dp">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/circle_breathe"
                    android:gravity="center"
                    android:text="☕"
                    android:textSize="26sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:letterSpacing="0.1"
                    android:text="请稍作休息"
                    android:textColor="@color/ink"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="检测到你正在使用手机。\n休息还没结束，别急着回来看屏幕。"
                    android:textColor="@color/inkSoft"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/popupRemain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="剩余 05:00"
                    android:textColor="@color/fir"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/popupOk"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/btn_primary"
                    android:paddingStart="40dp"
                    android:paddingEnd="40dp"
                    android:text="我知道了"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
